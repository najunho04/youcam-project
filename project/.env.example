# project/.env 로 복사해서 사용. (.env 는 git 제외)
DATABASE_URL=postgresql+psycopg://colorfit:colorfit@localhost:5432/colorfit
JWT_SECRET=change-me

# s3 | local (개발) | memory (테스트)
STORAGE_MODE=local
S3_BUCKET=
AWS_REGION=ap-northeast-2
# EC2 에서는 인스턴스 롤 사용. 로컬에서 S3 쓸 때만 키 입력
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# live | mock (크레딧 절약)
YOUCAM_MODE=mock
YOUCAM_API_KEY=

# fashion_clip | fake
EMBEDDING_MODE=fashion_clip

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
