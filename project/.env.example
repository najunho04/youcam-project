# project/.env 로 복사해서 사용 (cp .env.example .env). 백엔드와 docker compose(backend 컨테이너)가 이 파일 하나를 읽는다.
# 프론트(Vite)는 환경변수를 쓰지 않는다 (/api 는 vite 프록시로 :8000 에 전달).
# .env.example 은 git 에 올라간다. 실제 키는 .env 에만 넣는다. 테스트는 conftest.py 가 memory / mock / fake 로 강제하므로 이 값과 무관하다.

# ---- DB · 인증 (공용: shared/database, shared/security) ---------------------------------
# 개발: make dev 가 띄우는 로컬 컨테이너. 배포(make up)는 docker-compose.yml 이 db 호스트로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://colorfit:colorfit@localhost:5432/colorfit
# JWT 서명 키 (auth 슬라이스가 발급, 모든 인증 API 가 검증). python3 -c "import secrets;print(secrets.token_urlsafe(48))" 로 생성
JWT_SECRET=change-me

# ---- 저장소 (공용: shared/storage) -------------------------------------------------------
# 쓰는 슬라이스: personal_color(얼굴·상반신 사진), wardrobe(옷장 사진), fitting(피팅 결과), auth·profile(사진 URL 생성)
# local = backend/var/storage 에 저장 (개발) / s3 = S3 버킷 (배포, YouCam live 테스트)
#   주의: YouCam 은 우리가 넘긴 이미지 URL 을 직접 내려받는다. local 의 localhost URL 은 못 열기 때문에
#         YOUCAM_MODE=live 로 실제 호출할 때는 반드시 STORAGE_MODE=s3 여야 한다.
STORAGE_MODE=local
# S3 버킷 이름 (STORAGE_MODE=s3 일 때). 비공개 버킷(퍼블릭 액세스 전부 차단, SSE-S3 암호화). 이미지는 presigned URL 로만 노출된다.
S3_BUCKET=youcamapi-hackathon-1013
AWS_REGION=ap-northeast-2
# 보통 비워둔다. boto3 가 자격증명을 자동으로 찾는다: 이 값 → ~/.aws/credentials → EC2 인스턴스 롤.
#   make dev (백엔드를 호스트에서 실행) = ~/.aws/credentials (aws configure 로 설정한 키) 사용
#   make up (EC2) = 인스턴스에 붙인 IAM 롤 사용
#   로컬에서 백엔드를 컨테이너로 띄울 때만 입력 (컨테이너 안에는 ~/.aws 가 없다). 권한: 해당 버킷 s3:PutObject/GetObject/DeleteObject
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# local 모드 이미지 URL 접두 (브라우저가 여는 주소)
PUBLIC_BASE_URL=http://localhost:8000

# ---- YouCam (공용: shared/youcam) ---------------------------------------------------------
# 쓰는 슬라이스: personal_color(피부톤 분석, 20 units/회), fitting(가상 피팅 cloth-v4)
# mock = 고정 응답 (개발 기본, 크레딧 0) / live = 실제 호출 (크레딧 소모, STORAGE_MODE=s3 필요)
YOUCAM_MODE=mock
# [입력 필요] Perfect Corp YouCam API 콘솔에서 발급한 API Key. 헤더 "Authorization: Bearer <키>" 로 전송된다.
YOUCAM_API_KEY=

# ---- 임베딩 모델 (공용: shared/embedding) -------------------------------------------------
# 쓰는 슬라이스: product_ingest(상품 이미지), wardrobe(옷장 사진), recommendation(취향 벡터)
# fashion_clip = 실제 모델 (첫 실행 때 HuggingFace 에서 약 600MB 다운로드, CPU 에서 동작) / fake = 해시 기반 가짜 벡터
# 개발 중 빠르게 화면만 볼 때는 fake 로 바꿔도 된다. 단, fake 로 적재한 상품은 추천 품질이 의미 없다.
EMBEDDING_MODE=fashion_clip

# ---- eBay Browse API (product_ingest 슬라이스 전용, 1회 배치) ------------------------------
# 쓰는 곳: make ingest. 서버 API 는 이 키를 쓰지 않는다.
# [입력 필요] https://developer.ebay.com → My Account → Application Keys → Production 키셋의 App ID / Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
